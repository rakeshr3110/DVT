      <column caption='Total Revenue' datatype='real' name='[Calculation_0647653819015168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([stays_in_weekend_nights] + [stays_in_week_nights]) * [adr])' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_0647653819199489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[hotel_bookings_059BE7A28C7A4615BC80C1F6D6A6C3D8])' />
      </column>
      <column caption='Cancellation Rate' datatype='real' default-format='p0.00%' name='[Calculation_0647653819285506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([is_canceled])) / COUNT([__tableau_internal_object_id__].[hotel_bookings_059BE7A28C7A4615BC80C1F6D6A6C3D8])' />
      </column>
      <column caption='Average ADR' datatype='real' name='[Calculation_0647653819768835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([adr])' />
      </column>
      <column caption='Dynamic Metric Measure' datatype='real' name='[Calculation_0647653824942085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0647653824425988]&#13;&#10;    WHEN &apos;Total Revenue&apos; THEN [Calculation_0647653819015168]&#13;&#10;    WHEN &apos;Total Bookings&apos; THEN [Calculation_0647653819199489]&#13;&#10;    WHEN &apos;Cancellation Rate&apos; THEN [Calculation_0647653819285506]&#13;&#10;END' />
      </column>
